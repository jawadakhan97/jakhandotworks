```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/
*.o
*.obj
*.out
build/
dist/
*.class
*.so
*.dll
*.exe

# Dependencies
node_modules/
venv/
.venv/
.env
.env.local
.env.*

# Logs and temp files
*.log
*.tmp
*.swp
*.swo

# Editors and IDEs
.vscode/
.idea/
*.swp
*.swo

# System files
.DS_Store
Thumbs.db

# Coverage and testing
.coverage
coverage/
htmlcov/

# Package managers
.npm/
.yarn/
.pip/
.mypy_cache/
.pytest_cache/
target/
.gradle/

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```