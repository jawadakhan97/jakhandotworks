```gitignore
# Build artifacts and generated files
public/

# Cache directories
__pycache__/
*.pyc
*.pyo
*.pyd

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*
!.env.example

# Logs
*.log

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor specific
.vscode/
.idea/
*.swp
*.swo

# Coverage reports
coverage/
htmlcov/
.coverage
*.coverage

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/
.installed.cfg
*.egg

# Testing
.pytest_cache/
.mypy_cache/
.tox/

# Compressed files
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
*.gz
*.rar
*.7z
```